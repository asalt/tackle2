{% extends "base_report.html.j2" %}

{% block title %}AI Summaries — {{ savedir_name }}{% endblock %}

{% block content %}
<header>
  {% if show_links and back_href %}
  <p class="meta"><a href="{{ back_href }}">← Back to Summary</a></p>
  {% endif %}
  <h1>AI Summaries</h1>
  <p class="subtitle">{{ savedir_name }}</p>
  <p class="meta">Generated {{ generated_at }} from <code>{{ savedir_path }}</code></p>
</header>

<section class="llm-summary">
  <h2>Use With Care</h2>
  <p>These AI-generated notes can make mistakes. Check important findings against the source tables, plots, and pathway results before relying on them.</p>
  <p class="meta">This summary flow is built with llama3.1 tulu via the shared agent API.</p>
</section>

{% if run_anchor or toc_entries %}
<nav class="collection-nav toc-nav">
  <h2>Contents</h2>
  <ul class="toc-list">
    {% if run_anchor %}
    <li><a href="#{{ run_anchor }}">Run Overview</a></li>
    {% endif %}
    {% for entry in toc_entries %}
    <li>
      <a href="{{ entry.href }}">{{ entry.label }}</a>
      {% if entry.children %}
      <ul class="toc-sublist">
        {% for child in entry.children %}
        <li><a href="{{ child.href }}">{{ child.label }}</a></li>
        {% endfor %}
      </ul>
      {% endif %}
    </li>
    {% endfor %}
  </ul>
</nav>
{% endif %}

{% if run_summary %}
<section class="llm-summary" id="{{ run_anchor }}">
  <h2>Run Overview</h2>
  <p>{{ run_summary.text }}</p>
  {% if run_summary.bullets %}
  <ul>
    {% for bullet in run_summary.bullets %}
    <li>{{ bullet }}</li>
    {% endfor %}
  </ul>
  {% endif %}
  {% if run_summary.model %}
  <p class="meta">Generated with {{ run_summary.model }}</p>
  {% endif %}
</section>
{% endif %}

{% include "_ai_summary_body.html.j2" %}

<footer>
  <p>Static AI summary report generated by tackle2.</p>
</footer>
{% endblock %}
